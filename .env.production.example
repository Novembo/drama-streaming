# Production secrets: create /opt/drama-benin/.env on the server (chmod 600). NEVER commit it.
# Names match backend/app/core/config.py. Unknown names are silently ignored by pydantic, so copy them verbatim.
ENVIRONMENT=production
IMAGE_REPO=ghcr.io/CHANGE-ME/drama-benin-api
API_DOMAIN=api.example.com

POSTGRES_USER=drama
POSTGRES_PASSWORD=GENERATE-ME
POSTGRES_DB=drama_benin
DATABASE_URL=postgresql+psycopg://drama:GENERATE-ME@db:5432/drama_benin
REDIS_URL=redis://redis:6379/0

# python -c "import secrets; print(secrets.token_urlsafe(48))"   (the app refuses to start with a weak/default value)
JWT_SECRET=
JWT_ISSUER=drama-benin
ACCESS_TOKEN_MINUTES=20          # must stay <= 60 in production
REFRESH_TOKEN_DAYS=30

PUBLIC_API_URL=https://api.example.com
PAYMENT_RETURN_URL=https://app.example.com/payment/result
FRONTEND_ORIGINS=https://app.example.com

FEDAPAY_ENVIRONMENT=live
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

CINETPAY_ENVIRONMENT=live
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_BASE_URL=

TMDB_API_KEY=
